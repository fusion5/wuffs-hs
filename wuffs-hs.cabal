cabal-version:   3.12
name:            wuffs-hs
version:         0.1.0.0
synopsis:        Bindings for wuffs, the safe image codec

-- description:
license:         MIT
license-file:    LICENSE
author:          Dragos Ionita
maintainer:      dragos.0x55@gmail.com

-- copyright:
category:        Codec
build-type:      Simple
extra-doc-files: CHANGELOG.md

-- extra-source-files:

common shared-properties
  default-language:   GHC2024
  default-extensions:
    CPP
    DataKinds
    DeriveFunctor
    DeriveGeneric
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    ScopedTypeVariables
    StrictData
    TemplateHaskell
    TypeApplications

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists
    -Wmissing-home-modules -Wno-orphans -Wpartial-fields
    -Wredundant-constraints -Wunused-packages
    -Wno-pattern-namespace-specifier -Wno-unrecognised-warning-flags

library
  import:            shared-properties
  exposed-modules:   Codec.Wuffs
  other-modules:
    Codec.Wuffs.Bindings.Generated
    Codec.Wuffs.Bindings.Generated.FunPtr
    Codec.Wuffs.Bindings.Generated.Global
    Codec.Wuffs.Bindings.Generated.Safe
    Codec.Wuffs.Bindings.Generated.Unsafe
    PackageInfo_wuffs_hs
    Paths_wuffs_hs

  autogen-modules:
    Paths_wuffs_hs
    PackageInfo_wuffs_hs

  -- other-extensions:
  build-depends:
    , base
    , bytestring
    , containers
    , hs-bindgen-runtime
    , JuicyPixels
    , vector

  pkgconfig-depends: wuffs
  hs-source-dirs:    src

  if arch(wasm32)
    hs-source-dirs: src-wasm

  else
    hs-source-dirs: src-native

  default-language:  GHC2024

test-suite wuffs-hs-test
  import:            shared-properties
  default-language:  GHC2024
  other-modules:
    PackageInfo_wuffs_hs
    Paths_wuffs_hs

  autogen-modules:
    Paths_wuffs_hs
    PackageInfo_wuffs_hs

  -- other-extensions:
  type:              exitcode-stdio-1.0
  hs-source-dirs:    test
  main-is:           Main.hs
  build-depends:
    , base
    , bytestring
    , directory    >=1.3.9   && <2
    , hspec        >=2.11.17 && <2.12
    , JuicyPixels
    , temporary    >=1.3     && <2
    , wuffs-hs

  pkgconfig-depends: wuffs
